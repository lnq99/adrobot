# Copy to .env and fill in your key (get it from the Keitaro admin → "API key").
# .env is gitignored — never commit the real key.
#
# NOTE: this is a minimal placeholder. The full config schema (DB, how the
# domain/group/source are resolved, etc.) will be defined during design.

KEITARO_API_KEY=your_api_key_here
KEITARO_BASE_URL=https://keitaro-for-tests.etolegko.com/admin_api/v1
